# ==============================================================================
# SERENDIB ESCAPES — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your production/local values.
# NEVER commit .env.local to version control.
# ==============================================================================

# 1. MongoDB Atlas Connection String
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/serendib-escapes?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://your_user:your_password@cluster0.mongodb.net/serendib-escapes?retryWrites=true&w=majority"

# 2. JWT Signing Secret (minimum 32 random characters; generate via: openssl rand -base64 32)
JWT_SECRET="replace-with-a-cryptographically-random-32-plus-char-secret"

# 3. Admin Portal Credentials
# Generate ADMIN_PASSWORD_HASH via:
#   node -e "const b=require('bcryptjs'); console.log(b.hashSync('YourStrongPassword!', 12))"
ADMIN_EMAIL="admin@serendibescapes.lk"
ADMIN_PASSWORD_HASH="$2b$12$replaceWithYourGeneratedBcryptHash"

# 4. Protected Database Seeder Secret (used in Authorization: Bearer <SEED_SECRET> on POST /api/seed)
SEED_SECRET="replace-with-a-random-seed-secret-key"

# 5. Optional: Static USD -> LKR Display Rate (defaults to 300)
NEXT_PUBLIC_USD_TO_LKR="300"

# 6. Optional: IP Hash Salt for privacy-preserving rate-limit & audit logging
IP_HASH_SALT="serendib-zora-salt-2026"

# 7. Public WhatsApp Business Number (digits only, with country code, e.g., 94771234567)
NEXT_PUBLIC_WHATSAPP_NUMBER="94771234567"
